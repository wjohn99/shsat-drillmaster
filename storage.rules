rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isTutor() {
      return isSignedIn()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'tutor';
    }

    function isApprovedParentOf(boardId) {
      let linkPath = /databases/(default)/documents/parent_links/$(request.auth.uid);
      return isSignedIn()
        && firestore.exists(linkPath)
        && firestore.get(linkPath).data.parentUid == request.auth.uid
        && firestore.get(linkPath).data.status == 'approved'
        && firestore.get(linkPath).data.studentUid == boardId;
    }

    function isDemo() {
      return isSignedIn()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'demo';
    }

    function isDemoSandboxOwner(boardId) {
      let board = firestore.get(/databases/(default)/documents/workspace_boards/$(boardId));
      return isDemo()
        && board.data.demoAccount == true
        && board.data.demoOwnerUid == request.auth.uid;
    }

    function canAccessWorkspaceBoard(boardId) {
      let board = firestore.get(/databases/(default)/documents/workspace_boards/$(boardId));
      return isSignedIn()
        && board != null
        && (board.data.studentUid == request.auth.uid || isTutor() || isDemoSandboxOwner(boardId));
    }

    function canReadWorkspaceFile(boardId) {
      return canAccessWorkspaceBoard(boardId) || isApprovedParentOf(boardId);
    }

    // Shared board-template PDFs (SHSAT practice tests, later exam packs).
    match /workspace-templates/{templateId}/{fileName} {
      allow read: if isSignedIn() && fileName.matches('.*\\.pdf$');
      allow write: if false;
    }

    // Workspace homework files: PDF, JPEG, and PNG. No uploads anywhere else in the bucket.
    match /workspace/{boardId}/cards/{cardId}/{fileName} {
      allow read: if canReadWorkspaceFile(boardId);

      allow write: if canAccessWorkspaceBoard(boardId)
        && request.resource.size > 0
        && request.resource.size <= 25 * 1024 * 1024
        && request.resource.contentType in ['application/pdf', 'image/jpeg', 'image/png']
        && fileName.matches('.*\\.(pdf|png|jpg|jpeg)$');

      allow delete: if false;
    }

    // Original source files that include tutor-only notes. Not readable by students or parents.
    match /workspace-tutor/{boardId}/source/{fileName} {
      allow read: if isTutor();
      allow write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
