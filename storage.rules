rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isTutor() {
      return isSignedIn()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'tutor';
    }

    function canAccessWorkspaceBoard(boardId) {
      let board = firestore.get(/databases/(default)/documents/workspace_boards/$(boardId));
      return isSignedIn()
        && board != null
        && (board.data.studentUid == request.auth.uid || isTutor());
    }

    // Workspace PDFs only — no uploads anywhere else in the bucket.
    match /workspace/{boardId}/cards/{cardId}/{fileName} {
      allow read: if canAccessWorkspaceBoard(boardId);

      allow write: if isTutor()
        && canAccessWorkspaceBoard(boardId)
        && request.resource.size > 0
        && request.resource.size <= 25 * 1024 * 1024
        && request.resource.contentType == 'application/pdf'
        && fileName.matches('.*\\.pdf$');

      allow delete: if isTutor() && canAccessWorkspaceBoard(boardId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
