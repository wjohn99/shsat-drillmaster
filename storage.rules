rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isTutor() {
      return isSignedIn()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'tutor';
    }

    function isApprovedParentOf(boardId) {
      let linkPath = /databases/(default)/documents/parent_links/$(request.auth.uid);
      return isSignedIn()
        && firestore.exists(linkPath)
        && firestore.get(linkPath).data.parentUid == request.auth.uid
        && firestore.get(linkPath).data.status == 'approved'
        && firestore.get(linkPath).data.studentUid == boardId;
    }

    function canAccessWorkspaceBoard(boardId) {
      let board = firestore.get(/databases/(default)/documents/workspace_boards/$(boardId));
      return isSignedIn()
        && board != null
        && (board.data.studentUid == request.auth.uid || isTutor());
    }

    function canReadWorkspaceFile(boardId) {
      return canAccessWorkspaceBoard(boardId) || isApprovedParentOf(boardId);
    }

    // Workspace homework files: PDF, JPEG, and PNG. No uploads anywhere else in the bucket.
    match /workspace/{boardId}/cards/{cardId}/{fileName} {
      allow read: if canReadWorkspaceFile(boardId);

      allow write: if canAccessWorkspaceBoard(boardId)
        && request.resource.size > 0
        && request.resource.size <= 25 * 1024 * 1024
        && request.resource.contentType in ['application/pdf', 'image/jpeg', 'image/png']
        && fileName.matches('.*\\.(pdf|png|jpg|jpeg)$');

      allow delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
